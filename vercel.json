{
  "buildCommand": "cd pbn-fintech-app/web && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "pbn-fintech-app/web/build",
  "installCommand": "cd pbn-fintech-app/web && npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_DEMO_MODE": "true",
    "REACT_APP_API_URL": "https://api-demo.pbn-fintech.app/api",
    "REACT_APP_SOCKET_URL": "https://api-demo.pbn-fintech.app"
  }
}
