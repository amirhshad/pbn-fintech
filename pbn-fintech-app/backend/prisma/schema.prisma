// PBN Fintech Database Schema - SQLite Version for Prototype
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(uuid())
  phoneNumber            String   @unique
  phoneVerified          Boolean  @default(false)
  phoneVerificationCode  String?
  phoneVerificationExpiry DateTime?

  // Profile Information
  fullName               String
  dutchIdNumber          String?  @unique
  profilePhotoUrl        String?
  dateOfBirth            DateTime?

  // Verification Status (String instead of enum for SQLite)
  verificationStatus     String   @default("PENDING") // PENDING, PHONE_VERIFIED, ID_VERIFIED, FULLY_VERIFIED, REJECTED
  verificationDocuments  String?  // JSON array of URLs
  verifiedAt             DateTime?

  // Trust & Reputation
  trustScore             Float    @default(0.00)
  totalTransactions      Int      @default(0)
  successfulTransactions Int      @default(0)

  // Location (for matching)
  locationLat            Float?
  locationLng            Float?
  locationUpdatedAt      DateTime?

  // Account Status
  isActive               Boolean  @default(true)
  isBanned               Boolean  @default(false)
  banReason              String?
  bannedAt               DateTime?

  // Timestamps
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  lastLoginAt            DateTime?

  // Relations
  cashRequests           CashRequest[]
  givenTransactions      Transaction[]     @relation("CashGiver")
  receivedTransactions   Transaction[]     @relation("CashReceiver")
  reviewsGiven           UserReview[]      @relation("Reviewer")
  reviewsReceived        UserReview[]      @relation("ReviewedUser")
  disputesReported       Dispute[]         @relation("Reporter")
  disputesAgainst        Dispute[]         @relation("ReportedAgainst")
  feePayments            FeePayment[]
  userSessions           UserSession[]

  @@map("users")
}

model CashRequest {
  id                  String      @id @default(uuid())
  userId              String
  requestType         String      // NEED_CASH, HAVE_CASH
  amount              Float
  currency            String      @default("EUR")

  // Location
  locationLat         Float
  locationLng         Float
  locationDescription String?
  radiusKm            Int         @default(5)

  // Special Requirements
  specialRequirements String?
  minUserRating       Float?

  // Status & Timing
  status              String      @default("ACTIVE") // ACTIVE, MATCHED, EXPIRED, CANCELLED
  expiresAt           DateTime?

  // Timestamps
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches1            Match[]     @relation("Request1")
  matches2            Match[]     @relation("Request2")

  @@map("cash_requests")
}

model Match {
  id                String      @id @default(uuid())
  requestId1        String      // need_cash request
  requestId2        String      // have_cash request
  user1Id           String      // person who needs cash
  user2Id           String      // person who has cash

  // Match Details
  matchedAmount     Float
  matchScore        Float?      // algorithm match score

  // Status & Coordination
  status            String      @default("PENDING") // PENDING, ACCEPTED, MEETING, COMPLETED, CANCELLED, EXPIRED

  // Meeting Coordination
  agreedLocation    String?
  agreedLocationLat Float?
  agreedLocationLng Float?
  scheduledTime     DateTime?

  // User Responses
  user1Accepted     Boolean     @default(false)
  user2Accepted     Boolean     @default(false)
  user1AcceptedAt   DateTime?
  user2AcceptedAt   DateTime?

  // Timestamps
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  expiredAt         DateTime?

  // Relations
  request1          CashRequest @relation("Request1", fields: [requestId1], references: [id])
  request2          CashRequest @relation("Request2", fields: [requestId2], references: [id])
  transactions      Transaction[]
  chatMessages      ChatMessage[]

  @@map("matches")
}

model Transaction {
  id                     String    @id @default(uuid())
  matchId                String
  amount                 Float
  platformFee            Float     @default(2.00)

  // Transaction Security
  transactionCode        String    @unique // 6-digit verification code
  qrCodeHashGiver        String?   // Hash of giver's QR code
  qrCodeHashReceiver     String?   // Hash of receiver's QR code
  qrCodeExpiresAt        DateTime?

  // Participants
  cashGiverId            String
  cashReceiverId         String

  // Confirmation System
  giverConfirmed         Boolean   @default(false)
  receiverConfirmed      Boolean   @default(false)
  giverConfirmedAt       DateTime?
  receiverConfirmedAt    DateTime?
  giverQRScanned         Boolean   @default(false)
  receiverQRScanned      Boolean   @default(false)

  // Location Verification
  locationVerified       Boolean   @default(false)
  actualMeetingLat       Float?
  actualMeetingLng       Float?
  locationAccuracyMeters Int?

  // Status & Timing
  status                 String    @default("PENDING") // PENDING, MEETING, EXCHANGING, COMPLETED, DISPUTED, CANCELLED, TIMEOUT
  startedAt              DateTime?
  completedAt            DateTime?
  timeoutAt              DateTime? // Auto-cancel after 4 hours

  // Fee Collection
  platformFeeCollected   Boolean   @default(false)
  feeCollectedAt         DateTime?

  // Timestamps
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  match                  Match     @relation(fields: [matchId], references: [id])
  cashGiver              User      @relation("CashGiver", fields: [cashGiverId], references: [id])
  cashReceiver           User      @relation("CashReceiver", fields: [cashReceiverId], references: [id])
  reviews                UserReview[]
  disputes               Dispute[]
  feePayments            FeePayment[]

  @@map("transactions")
}

model SafeLocation {
  id             String   @id @default(uuid())
  name           String
  address        String
  latitude       Float
  longitude      Float
  locationType   String   // BANK, POLICE_STATION, MALL, CAFE, LIBRARY, etc.
  description    String?
  operatingHours String?

  // Safety & Verification
  verified       Boolean  @default(false)
  safetyRating   Float    @default(0.00)
  usageCount     Int      @default(0)

  // Geographic Info
  city           String
  postalCode     String?
  country        String   @default("Netherlands")

  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("safe_locations")
}

model Dispute {
  id                 String    @id @default(uuid())
  transactionId      String
  reporterId         String
  reportedAgainstId  String

  // Dispute Details
  disputeType        String    // NO_SHOW, WRONG_AMOUNT, FAKE_MONEY, SAFETY_CONCERN, etc.
  title              String
  description        String
  evidenceUrls       String?   // JSON array of URLs

  // Status & Resolution
  status             String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED, ESCALATED
  priority           Int       @default(1) // 1=Low, 2=Medium, 3=High
  resolution         String?
  resolvedBy         String?

  // Compensation
  compensationAmount Float?
  compensationPaid   Boolean   @default(false)

  // Timestamps
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?

  // Relations
  transaction        Transaction @relation(fields: [transactionId], references: [id])
  reporter           User        @relation("Reporter", fields: [reporterId], references: [id])
  reportedAgainst    User        @relation("ReportedAgainst", fields: [reportedAgainstId], references: [id])

  @@map("disputes")
}

model UserReview {
  id                  String      @id @default(uuid())
  transactionId       String
  reviewerId          String
  reviewedUserId      String

  // Review Content
  rating              Int         // 1-5 stars
  reviewText          String?
  reviewType          String      // GIVER_REVIEW, RECEIVER_REVIEW

  // Review Categories
  communicationRating Int?
  reliabilityRating   Int?
  safetyRating        Int?

  // Status
  isVisible           Boolean     @default(true)
  flagged             Boolean     @default(false)

  // Timestamps
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  transaction         Transaction @relation(fields: [transactionId], references: [id])
  reviewer            User        @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedUser        User        @relation("ReviewedUser", fields: [reviewedUserId], references: [id])

  @@map("user_reviews")
}

model ChatMessage {
  id          String   @id @default(uuid())
  matchId     String
  senderId    String
  message     String
  messageType String   @default("text") // text, location, system

  // Message Status
  isRead      Boolean  @default(false)
  readAt      DateTime?

  // Timestamps
  createdAt   DateTime @default(now())

  // Relations
  match       Match    @relation(fields: [matchId], references: [id])

  @@map("chat_messages")
}

model FeePayment {
  id            String    @id @default(uuid())
  userId        String
  transactionId String?

  // Payment Details
  amount        Float
  currency      String    @default("EUR")
  paymentType   String    // TRANSACTION_FEE, MONTHLY_SUBSCRIPTION, PENALTY

  // Payment Method & Status
  paymentMethod String?
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE, WAIVED, REFUNDED

  // Due Dates & Collections
  dueDate       DateTime?
  paidAt        DateTime?
  collectedBy   String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id])
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  @@map("fee_payments")
}

model UserSession {
  id            String   @id @default(uuid())
  userId        String
  sessionToken  String   @unique
  deviceInfo    String?
  ipAddress     String?

  // Session Status
  isActive      Boolean  @default(true)
  expiresAt     DateTime

  // Timestamps
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}
