# PBN Fintech Environment Variables

# Database
DATABASE_URL="postgresql://pbn_user:pbn_password@localhost:5432/pbn_fintech"
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-here"
API_URL="http://localhost:3000"

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"

# Maps & Location
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Dutch ID Verification
DUTCH_ID_OCR_API_KEY="your-ocr-service-api-key"

# Security
BCRYPT_ROUNDS=12
QR_CODE_EXPIRY_HOURS=4
TRANSACTION_TIMEOUT_MINUTES=240

# Development
LOG_LEVEL=debug
ENABLE_CORS=true

# Production (when deploying)
# DATABASE_URL="postgresql://user:pass@prod-db:5432/pbn_fintech"
# NODE_ENV=production
# JWT_SECRET="production-jwt-secret"
# LOG_LEVEL=info